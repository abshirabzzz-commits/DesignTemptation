# ==============================================================================
# DESIGN TEMPTATION — Environment Configuration Template
# Duplicate this file to .env or .env.local for development / production.
# NEVER commit .env or files with real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend (Next.js)
# ------------------------------------------------------------------------------
# Production custom domain URL without trailing slash (e.g. https://designtemptation.com)
NEXT_PUBLIC_SITE_URL=https://designtemptation.com

# Backend API base URL for client-side API requests (Auth, Cart, Wishlist, Products).
# In production on Vercel, set to: https://designtemptation.onrender.com
# In local development, defaults to: http://127.0.0.1:8000
NEXT_PUBLIC_DJANGO_API_URL=https://designtemptation.onrender.com

# Backend API endpoint URL used by Next.js server route handlers (optional if using Resend directly)
# DJANGO_API_URL=http://127.0.0.1:8000/api/enquiries/

# ------------------------------------------------------------------------------
# Transactional Email (Resend)
# ------------------------------------------------------------------------------
# API Key from Resend dashboard (e.g. re_123456789)
RESEND_API_KEY=

# Studio destination address where inquiries should be received (e.g. enquiriesdesigntemptation@gmail.com)
ENQUIRY_TO_EMAIL=enquiriesdesigntemptation@gmail.com

# Verified sending address configured on your custom domain in Resend (e.g. concierge@designtemptation.com or notifications@designtemptation.com)
ENQUIRY_FROM_EMAIL=concierge@designtemptation.com

# Set to "true" to simulate successful email delivery during local development and testing without sending real emails
ENQUIRY_MOCK_DELIVERY=false

# ------------------------------------------------------------------------------
# Backend (Django)
# ------------------------------------------------------------------------------
# Required in production. Generate a strong, unique 50+ character secret key.
# In local development (DJANGO_DEBUG=True), a safe dev-only fallback is used.
DJANGO_SECRET_KEY=

# Set to True only for local development. In production, leave False or unset.
DJANGO_DEBUG=False

# Comma-separated list of valid hostnames/domains for the backend server
# Required when DJANGO_DEBUG=False (e.g. api.designtemptation.com,localhost)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated list of approved frontend origins allowed to send requests
# (e.g. https://designtemptation.com,http://localhost:3000)
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Comma-separated list of trusted origins for CSRF protection
# (e.g. https://designtemptation.com,https://api.designtemptation.com)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production HTTPS redirect override (set False if SSL terminates at load balancer/reverse proxy)
# DJANGO_SECURE_SSL_REDIRECT=True

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL connection string for production (Neon, Supabase, RDS, etc.)
# If unset, Django falls back to local backend/db.sqlite3 for development
# DATABASE_URL=postgresql://user:password@hostname:5432/interior_studio

# Manual PostgreSQL credentials (alternative to DATABASE_URL)
# USE_POSTGRES=False
# POSTGRES_DB=interior_studio
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Cloud Media Storage (AWS S3 / Cloudflare R2) - Optional
# ------------------------------------------------------------------------------
# USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=auto
# AWS_S3_ENDPOINT_URL=
